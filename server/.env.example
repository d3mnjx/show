# Copy this file to .env and set the values. Never commit .env.

# The secret that an agent sends to make, read and delete pages. Use 24 or more random characters,
# for example the output of: openssl rand -base64 32
SHOW_TOKEN=

# The address that a browser uses to reach this server, without a slash at the end.
# The server puts it in front of each page link. Example: https://show.example.com
SHOW_PUBLIC_URL=

# The port on the host.
SHOW_PORT=7469
