<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>show</AssemblyName>
    <RootNamespace>Show</RootNamespace>
    <PublishAot>true</PublishAot>
    <!-- The browser formats all dates, so the server needs no culture data. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The stylesheet, the page script and the fonts are compiled into the binary, so a deploy is one file with nothing next to it. -->
    <EmbeddedResource Include="web/*" LogicalName="%(Filename)%(Extension)" />
    <Content Remove="web/**" />
  </ItemGroup>

</Project>
